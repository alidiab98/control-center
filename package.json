{
  "name": "control-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local control center: Claude Code agents, Yandex Tracker tasks, Telegram work folder",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "shared",
    "web",
    "server",
    "e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @control-center/web",
    "build": "npm run build --workspace @control-center/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
